{
  "case_id": "sf_unknown_tool_choice_probe",
  "title": "隐性参数探针：tool_choice（官方 chat schema 无此参数，messages 协议才有）",
  "category": "unknown",
  "target_group": "protocol_tools",
  "parameters": [
    "tools",
    "tool_choice"
  ],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "Pro/zai-org/GLM-4.7",
    "messages": [
      {
        "role": "user",
        "content": "用一句中文打个招呼。"
      }
    ],
    "max_tokens": 64,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "查天气",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            }
          }
        }
      }
    ],
    "tool_choice": "auto"
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "ignored",
    "doc_support": "undocumented",
    "undocumented_scenario": "silent_ignore",
    "required_response_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices",
      "usage"
    ],
    "notes": "官方 chat schema 未定义 tool_choice；实测带 tools 传 \"auto\" 返回 200 接受。来源：实测（Noctua，2026-07-08，probe=sf_tool_choice_probe）。实测模型 Qwen/Qwen3-8B（cn 站）。"
  }
}
