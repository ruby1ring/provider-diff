{
  "case_id": "or_length_max_completion_tokens_stop",
  "title": "max_completion_tokens and stop together",
  "category": "length",
  "parameters": ["max_completion_tokens", "stop"],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "openai/gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": "List three short steps as 1, 2, 3."
      }
    ],
    "max_completion_tokens": 48,
    "stop": "3"
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "required_response_fields": ["id", "object", "created", "model", "choices", "system_fingerprint"]
  }
}
