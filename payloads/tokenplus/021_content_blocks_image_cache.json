{
  "case_id": "tp_chat_content_blocks_image_cache",
  "title": "text and image_url content blocks with an explicit cache breakpoint",
  "category": "multimodal",
  "test_nature": "probabilistic",
  "parameters": [
    "messages[].content[].type",
    "messages[].content[].text",
    "messages[].content[].image_url.url",
    "messages[].content[].image_url.detail",
    "messages[].content[].cache_control.type",
    "messages[].content[].cache_control.enabled",
    "messages[].content[].cache_control.ttl",
    "messages[].content[].cache_control.breakpoints[].type",
    "messages[].content[].cache_control.breakpoints[].ttl"
  ],
  "requires_model_capability": "vision,explicit-cache",
  "optional": true,
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "qwen-vl-max",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Static context for this protocol test.",
            "cache_control": {
              "type": "ephemeral",
              "enabled": true,
              "ttl": "5m",
              "breakpoints": [
                {
                  "type": "ephemeral",
                  "ttl": "5m"
                }
              ]
            }
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/jpeg;base64,",
              "detail": "low"
            }
          },
          {
            "type": "text",
            "text": "Describe the image in one short phrase."
          }
        ]
      }
    ]
  },
  "expect": {
    "assistant_content_non_empty": true,
    "optional_capability_mismatch": true,
    "notes": "Vision and explicit cache behavior depend on the selected model and service. This is not an exact-image-content assertion."
  }
}