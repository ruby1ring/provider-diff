{
  "case_id": "tp_chat_length_truncate_finish_reason",
  "title": "max_tokens truncation returns finish_reason=length",
  "category": "length",
  "test_nature": "deterministic",
  "parameters": ["max_tokens", "choices[].finish_reason"],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-chat",
    "messages": [
      {"role": "user", "content": "请写一篇关于人工智能发展的长文，至少一千字。"}
    ],
    "max_tokens": 16
  },
  "expect": {
    "additional_response_path_values": {
      "choices[].finish_reason": "length"
    },
    "notes": "小 max_tokens 强制截断，断言 finish_reason 为 length（而非 stop）。思考型模型可能将预算全部用于思考、content 为空，因此不断言文本非空。"
  }
}
