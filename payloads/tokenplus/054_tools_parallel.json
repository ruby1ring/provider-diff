{
  "case_id": "tp_chat_tools_parallel",
  "title": "parallel_tool_calls=true requests independent weather calls",
  "category": "tools",
  "test_nature": "probabilistic",
  "parameters": ["tools[].type", "tools[].function.name", "tools[].function.description", "tools[].function.parameters", "tool_choice", "parallel_tool_calls"],
  "requires_model_capability": "tools,parallel-tool-calls",
  "optional": true,
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-chat",
    "messages": [{"role": "user", "content": "Use get_weather separately for Shanghai and Beijing. Make both tool calls now."}],
    "tools": [{
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Gets weather for one city.",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"city": {"type": "string"}},
          "required": ["city"]
        }
      }
    }],
    "tool_choice": "required",
    "parallel_tool_calls": true,
    "max_completion_tokens": 128
  },
  "expect": {
    "optional_capability_mismatch": true,
    "tool_calls_contract": true,
    "tool_call_required_names": ["get_weather"],
    "tool_call_input_required_fields": ["city"],
    "tool_call_input_field_types": {"city": "string"},
    "tool_call_input_allowed_values": {"city": ["Shanghai", "Beijing"]},
    "tool_call_input_distinct_fields": ["city"],
    "tool_call_input_no_additional_properties": true,
    "required_response_paths": [
      "choices[].message.role", "usage.prompt_tokens", "usage.completion_tokens", "usage.total_tokens"
    ],
    "response_path_types": {
      "id": "string", "object": "string", "created": "number", "model": "string", "choices": "array",
      "choices[].index": "number", "choices[].message": "object", "choices[].message.role": "string",
      "choices[].message.content": "string|null", "choices[].finish_reason": "string", "usage": "object",
      "usage.prompt_tokens": "number", "usage.completion_tokens": "number", "usage.total_tokens": "number"
    },
    "additional_response_path_values": {"choices[].finish_reason": "tool_calls"},
    "notes": "Probability case: a model may serialize calls despite the flag. Requires at least one requested tool call with valid args; when two calls are emitted, the runner enforces unique IDs and distinct Shanghai/Beijing arguments."
  }
}
