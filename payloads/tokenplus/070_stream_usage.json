{
  "case_id": "tp_chat_stream_usage",
  "title": "SSE stream with stream_options.include_usage",
  "category": "streaming",
  "test_nature": "deterministic",
  "parameters": [
    "stream",
    "stream_options.include_usage"
  ],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-chat",
    "messages": [
      {
        "role": "user",
        "content": "Stream one short sentence about TokenPlus usage reporting."
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "max_completion_tokens": 512
  },
  "expect": {
    "response_header_contains": {
      "content-type": "text/event-stream"
    },
    "response_mode": "sse",
    "required_chunk_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices"
    ],
    "usage_required_fields": [
      "prompt_tokens",
      "completion_tokens",
      "total_tokens"
    ],
    "openai_stream_contract": true,
    "stream_usage_chunk_shape": "openai_dedicated",
    "stream_done_required": true,
    "stream_incremental": true,
    "min_sse_chunks": 2,
    "min_content_chunks": 1,
    "notes": "Checks every OpenAI chunk's envelope and consistency, assistant delta, finish reason, dedicated final usage chunk, token arithmetic, and the terminal [DONE] marker."
  }
}