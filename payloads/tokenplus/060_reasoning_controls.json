{
  "case_id": "tp_chat_reasoning_controls",
  "title": "thinking, reasoning_effort, thinking_budget, and verbosity",
  "category": "reasoning",
  "test_nature": "probabilistic",
  "parameters": ["thinking.type", "reasoning_effort", "thinking_budget", "verbosity"],
  "requires_model_capability": "reasoning",
  "optional": true,
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-reasoner",
    "messages": [{"role": "user", "content": "Briefly solve: 12 compatibility cases plus 8 cases equals what?"}],
    "thinking": {"type": "enabled"},
    "reasoning_effort": "medium",
    "thinking_budget": 512,
    "verbosity": "low",
    "max_completion_tokens": 160
  },
  "expect": {
    "optional_capability_mismatch": true,
    "assistant_content_non_empty": true,
    "notes": "Whether a selected model exposes reasoning text or token details is model-dependent; this case verifies the documented control combination is accepted."
  }
}
