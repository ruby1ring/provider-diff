{
  "case_id": "tp_chat_tools_none",
  "title": "tool_choice=none must not return a tool call",
  "category": "tools",
  "test_nature": "deterministic",
  "parameters": ["tools", "tool_choice"],
  "requires_model_capability": "tools",
  "optional": true,
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-chat",
    "messages": [{"role": "user", "content": "Do not call a tool. Explain what get_weather does."}],
    "tools": [{
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Gets weather for a city.",
        "parameters": {"type": "object", "properties": {"city": {"type": "string"}}}
      }
    }],
    "tool_choice": "none",
    "max_completion_tokens": 96
  },
  "expect": {
    "assistant_content_non_empty": true,
    "optional_capability_mismatch": true,
    "notes": "Checks the negative tool-choice contract when the model supports tools."
  }
}
