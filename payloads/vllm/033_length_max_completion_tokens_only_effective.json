{
  "case_id": "vllm_length_max_completion_tokens_only_effective",
  "title": "仅 max_completion_tokens 生效性",
  "category": "length",
  "parameters": ["max_completion_tokens"],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "Qwen/Qwen2.5-7B-Instruct",
    "messages": [
      {
        "role": "user",
        "content": "请持续写一段很长的技术说明，不要提前结束，直到被截断为止。"
      }
    ],
    "max_completion_tokens": 64,
    "stream": false
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "output_cap_effective": "observed",
    "optional_capability_mismatch": true,
    "required_response_fields": ["id", "object", "created", "model", "choices", "usage"],
    "notes": "vLLM 可能不支持 max_completion_tokens；若 4xx 或 cap 未生效，与 max_tokens 单参 case 对比可判断字段支持情况。"
  }
}
