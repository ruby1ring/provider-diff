{
  "case_id": "vllm_sampling_top_p",
  "title": "top_p nucleus sampling",
  "category": "sampling",
  "parameters": [
    "top_p"
  ],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "NousResearch/Meta-Llama-3-8B-Instruct",
    "messages": [
      {
