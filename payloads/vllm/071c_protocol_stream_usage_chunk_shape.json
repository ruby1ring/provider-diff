{
  "case_id": "vllm_protocol_stream_usage_chunk_shape",
  "title": "流式 usage 应在独立 chunk（choices:[]）中返回",
  "category": "protocol",
  "parameters": ["stream", "stream_options.include_usage"],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "NousResearch/Meta-Llama-3-8B-Instruct",
    "messages": [{"role": "user", "content": "Stream a short sentence about usage."}],
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "max_tokens": 80
  },
  "expect": {
    "response_mode": "sse",
    "stream_usage_chunk_shape": "openai_dedicated",
    "stream_usage_in_sse": "required",
    "required_chunk_fields": ["id", "object", "created", "model", "choices"],
    "usage_required_fields": ["prompt_tokens", "completion_tokens", "total_tokens"],
    "stream_probe_attempts": 3,
    "optional_capability_mismatch": true,
    "notes": "验证 usage 是否在独立 chunk（choices:[]）中返回。部分 vLLM 版本或中断流可能省略末包 usage。"
  }
}
