{
  "case_id": "ali_protocol_stream_include_usage",
  "title": "stream_options.include_usage 每个 chunk 应带 usage 字段，最后一包返回统计值",
  "category": "protocol",
  "parameters": [
    "stream",
    "stream_options"
  ],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "deepseek-v4-pro",
    "messages": [
      {
        "role": "user",
        "content": "流式输出一句关于 usage 的说明。"
      }
    ],
    "stream": true,
    "enable_thinking": false,
    "max_tokens": 80,
    "stream_options": {
      "include_usage": true
    }
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "response_mode": "sse",
    "stream_usage_in_sse": "required",
    "required_chunk_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices"
    ],
    "usage_required_fields": [
      "prompt_tokens",
      "completion_tokens",
      "total_tokens"
    ],
    "notes": "OpenAI 规范：include_usage=true 时每个 chunk 都带 usage 字段（中间 chunk 为 null），最后一个专用 chunk（choices:[]）返回统计值。 Current test config has DashScope access to deepseek-v4-pro, so this case uses it for API-level compatibility validation.",
    "stream_usage_per_chunk": "field_required"
  }
}
