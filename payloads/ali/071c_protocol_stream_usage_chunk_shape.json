{
  "case_id": "ali_protocol_stream_usage_chunk_shape",
  "title": "流式 usage 应在独立 chunk（choices:[]）中返回",
  "category": "protocol",
  "parameters": [
    "stream",
    "stream_options"
  ],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "deepseek-v4-pro",
    "messages": [
      {
        "role": "user",
        "content": "流式输出一句关于 usage 的说明。"
      }
    ],
    "stream": true,
    "enable_thinking": false,
    "max_tokens": 80,
    "stream_options": {
      "include_usage": true
    }
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "response_mode": "sse",
    "stream_usage_chunk_shape": "openai_dedicated",
    "stream_usage_in_sse": "required",
    "required_chunk_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices"
    ],
    "usage_required_fields": [
      "prompt_tokens",
      "completion_tokens",
      "total_tokens"
    ],
    "stream_probe_attempts": 3,
    "notes": "验证 usage 是否在独立 chunk（choices:[]）中返回，而非与 finish_reason 合并。OpenAI 规范见 docs/api/openai.md。"
  }
}
