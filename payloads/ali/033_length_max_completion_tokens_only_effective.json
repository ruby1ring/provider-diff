{
  "case_id": "ali_length_max_completion_tokens_only_effective",
  "title": "仅 max_completion_tokens 生效性",
  "category": "length",
  "parameters": ["max_completion_tokens"],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "deepseek-v4-pro",
    "messages": [
      {
        "role": "user",
        "content": "请持续写一段很长的技术说明，不要提前结束，直到被截断为止。"
      }
    ],
    "max_completion_tokens": 64,
    "enable_thinking": false,
    "stream": false
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "output_cap_effective": "observed",
    "required_response_fields": ["id", "object", "created", "model", "choices", "usage"],
    "notes": "仅传 max_completion_tokens=64 强制长输出，观测该参数是否真限制输出。与 max_tokens 单参 case 对比可判断两字段是等价别名还是语义不同。"
  }
}
