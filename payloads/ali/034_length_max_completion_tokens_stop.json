{
  "case_id": "ali_length_max_completion_tokens_stop",
  "title": "max_completion_tokens 与 stop 组合",
  "category": "length",
  "parameters": ["max_completion_tokens", "stop"],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "deepseek-v4-pro",
    "messages": [
      {
        "role": "user",
        "content": "按 1、2、3 的格式列出三个测试步骤。"
      }
    ],
    "max_completion_tokens": 48,
    "stop": "3",
    "enable_thinking": false
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "required_response_fields": ["id", "object", "created", "model", "choices", "usage"],
    "notes": "同时传 max_completion_tokens 与 stop，验证组合是否被接受。"
  }
}
