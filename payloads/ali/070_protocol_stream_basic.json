{
  "case_id": "ali_protocol_stream_basic",
  "title": "stream 基础流式返回",
  "category": "protocol",
  "parameters": [
    "stream"
  ],
  "method": "POST",
  "path": "/v1/chat/completions",
  "payload": {
    "model": "deepseek-v4-pro",
    "messages": [
      {
        "role": "user",
        "content": "请用流式方式逐句输出 3 到 5 句简短中文问候，不要一次性全部给出。"
      }
    ],
    "stream": true,
    "max_tokens": 128
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "response_mode": "sse",
    "stream_incremental": true,
    "stream_probe_attempts": 1,
    "required_chunk_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices"
    ],
    "notes": "流式 case 验证 SSE/chunk 结构与增量分片（content 或 reasoning_content 合计至少 2 个增量 chunk）；探测 1 次。Current test config has DashScope access to deepseek-v4-pro, so this case uses it for API-level compatibility validation."
  }
}
