{
  "case_id": "deepseek_length_max_completion_tokens",
  "title": "max_completion_tokens 限制输出长度",
  "category": "length",
  "parameters": [
    "max_completion_tokens"
  ],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-v4-flash",
    "messages": [
      {
        "role": "user",
        "content": "用不超过二十个字解释单元测试。"
      }
    ],
    "max_completion_tokens": 32,
    "stream": false
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "ignored",
    "required_response_fields": [
      "id",
      "object",
      "created",
      "model",
      "choices",
      "usage",
      "system_fingerprint"
    ],
    "notes": "官方 schema 只有 max_tokens、无 max_completion_tokens；实测传入被静默忽略（cap=32 实际 completion_tokens=126）。来源：实测（Noctua，2026-07-12，case=deepseek_length_max_completion_tokens）。生效性见 033 单参 case。",
    "token_limit_enforced": false,
    "doc_support": "undocumented",
    "undocumented_scenario": "silent_ignore"
  }
}
