{
  "case_id": "deepseek_protocol_stream_basic",
  "title": "stream 基础流式返回",
  "category": "protocol",
  "parameters": ["stream"],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "deepseek-v4-flash",
    "messages": [
      {"role": "user", "content": "请用流式方式逐句输出 3 到 5 句简短中文问候，不要一次性全部给出。"}
    ],
    "stream": true,
    "max_tokens": 128
  },
  "expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "response_mode": "sse",
    "stream_incremental": true,
    "stream_probe_attempts": 1,
    "required_chunk_fields": ["id", "object", "created", "model", "choices"],
    "notes": "stream=true 时返回 text/event-stream，分片以 data: [DONE] 结束；增量分片按 content 或 reasoning_content 合计至少 2 个 chunk，探测 1 次。"
  }
}
