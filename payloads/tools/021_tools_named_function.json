{
  "case_id": "tools_named_function",
  "title": "tool_choice 指定函数名 · 必须调用 compatibility_status（不能只调别的工具）",
  "category": "tools",
  "parameters": ["tool_choice"],
  "requires_model_capability": "tools",
  "optional": true,
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": "Call compatibility_status for parameter response_format."
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "compatibility_status",
          "description": "Return compatibility status for one parameter.",
          "parameters": {
            "type": "object",
            "properties": {
              "parameter": { "type": "string" },
              "status": { "type": "string", "enum": ["accepted", "rejected", "warning"] }
            },
            "required": ["parameter", "status"]
          }
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": { "name": "compatibility_status" }
    },
    "max_completion_tokens": 120
  },
  "expect": {
    "axis": "named_function",
    "notes": "tool_choice 精确指定 compatibility_status 函数名（非 required/auto）；验证渠道按名称路由到正确工具。",
    "model_expect": {
      "qwen3.8-max": {
        "http_status": 400,
        "support_conclusion": "rejected_400",
        "evaluation_intent": "observe",
        "required_response_fields": null,
        "choice_required_fields": null,
        "notes": "qwen3.8-max 默认开启思考，而阿里在思考模式下不支持 tool_choice=required / 指定函数名，服务端按文档返回 400；关闭思考后两者均可用（见 model_behaviors_qwen/040·042 原厂参考用例）。本用例不传 enable_thinking，故对该模型预期为按文档拒绝。实测华北2/美东一致（2026-08-07）。"
      }
    }
  }
}
