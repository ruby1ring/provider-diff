{
  "case_id": "tools_choice_required",
  "title": "tool_choice required · 应返回 tool_calls",
  "category": "tools",
  "parameters": ["tools", "tool_choice"],
  "requires_model_capability": "tools",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": "Get the weather for Beijing."
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_current_weather",
          "description": "Get current weather for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "location": { "type": "string" },
              "unit": { "type": "string", "enum": ["celsius", "fahrenheit"] }
            },
            "required": ["location"]
          }
        }
      }
    ],
    "tool_choice": "required",
    "max_completion_tokens": 120
  },
  "expect": {
    "axis": "invoke",
    "notes": "tool_choice=required 时应返回 tool_calls；这是渠道是否真正支持工具调用的核心探针。",
    "model_expect": {
      "qwen3.8-max": {
        "http_status": 400,
        "support_conclusion": "rejected_400",
        "evaluation_intent": "observe",
        "required_response_fields": null,
        "choice_required_fields": null,
        "notes": "qwen3.8-max 默认开启思考，而阿里在思考模式下不支持 tool_choice=required / 指定函数名，服务端按文档返回 400；关闭思考后两者均可用（见 model_behaviors_qwen/040·042 原厂参考用例）。本用例不传 enable_thinking，故对该模型预期为按文档拒绝。实测华北2/美东一致（2026-08-07）。"
      }
    }
  }
}
