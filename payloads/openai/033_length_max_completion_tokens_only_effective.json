{
  "case_id": "oa_length_max_completion_tokens_only_effective",
  "title": "仅 max_completion_tokens 生效性",
  "category": "length",
  "parameters": ["max_completion_tokens"],
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-4o-mini",
    "messages": [
      {
