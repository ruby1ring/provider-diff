{
  "provider": "thinking_messages",
  "base_url": "https://api.anthropic.com/v1",
  "endpoint": "/messages",
  "method": "POST",
  "default_model": "claude-sonnet-4-6",
  "reasoning_model": "claude-sonnet-4-6",
  "vision_model": "",
  "notes": [
    "Anthropic Messages 专用 thinking 探针：仅用于 anthropic_messages 协议测评。",
    "与 payloads/thinking（Chat Completions）相互独立；同一语义探针在两个协议下分别维护。",
    "运行时请把 Base URL、Model 和 API Key 改成待测渠道。",
    "开启 case 检查 thinking block 与 usage.output_tokens_details.thinking_tokens；关闭 case 检查不应出现非空 thinking block。"
  ],
  "common_expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "required_response_fields": [
      "id",
      "type",
      "role",
      "content",
      "model",
      "usage"
    ],
    "content_required_fields": [
      "type"
    ],
    "usage_required_fields": [
      "input_tokens",
      "output_tokens"
    ]
  },
  "cases": [
    "001_baseline_no_thinking.json",
    "003_baseline_fixed_prompt.json",
    "004_baseline_default_effort.json",
    "040_thinking_object_enabled.json",
    "041_thinking_object_disabled.json",
    "042_thinking_object_enabled_budget_tokens.json",
    "043_thinking_object_adaptive.json"
  ]
}
