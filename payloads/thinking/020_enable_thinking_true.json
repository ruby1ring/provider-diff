{
  "case_id": "thinking_enable_thinking_true",
  "title": "enable_thinking=true 开启思考 · 应出现 reasoning/thinking 内容；usage 中 reasoning_tokens 或 thinking_tokens > 0",
  "category": "reasoning",
  "parameters": ["enable_thinking"],
  "requires_model_capability": "reasoning",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-5.1",
    "messages": [
      {
        "role": "user",
        "content": "Compute 23 + 19. Reply with one short sentence."
      }
    ],
    "enable_thinking": true,
    "max_completion_tokens": 512,
    "temperature": 0
  },
  "expect": {
    "dialect": "qwen_enable_thinking",
    "axis": "switch_on",
    "enum_value": "true",
    "http_status": 200,
    "thinking_location_probe": true,
    "thinking_evidence_required": true,
    "assistant_content_non_empty": true,
    "provider_extension": true,
    "notes": "Qwen/SiliconFlow/DashScope 风格开关。"
  }
}
