{
  "case_id": "thinking_object_adaptive",
  "title": "thinking.type=adaptive 开启思考 · 应出现 thinking 内容；usage reasoning_tokens/thinking_tokens > 0",
  "category": "reasoning",
  "parameters": ["thinking"],
  "requires_model_capability": "thinking",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-5.1",
    "messages": [
      {
        "role": "user",
        "content": "Use brief reasoning to compute 41 + 17, then give the final answer."
      }
    ],
    "thinking": {
      "type": "adaptive"
    },
    "max_completion_tokens": 512
  },
  "expect": {
    "dialect": "thinking_object",
    "axis": "switch_on",
    "enum_value": "adaptive",
    "http_status": 200,
    "thinking_location_probe": true,
    "thinking_evidence_required": true,
    "assistant_content_non_empty": true,
    "provider_extension": true,
    "notes": "MiniMax-M3 风格 thinking.type=adaptive 开启形态；adaptive 对 M3 等价于 thinking on。",
    "provider_expect": {
      "aliyun": {
        "http_status": 400,
        "support_conclusion": "rejected_400",
        "thinking_location_probe": null,
        "thinking_evidence_required": null,
        "assistant_content_non_empty": null,
        "required_response_fields": null,
        "choice_required_fields": null,
        "notes": "阿里 thinking.type 仅认 enabled/disabled/auto，adaptive 按文档 400 拒绝（2026-08-06 华北2/美东实测一致）。"
      }
    }
  }
}
