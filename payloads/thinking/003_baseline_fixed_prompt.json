{
  "case_id": "thinking_baseline_fixed_prompt",
  "title": "baseline 对照 prompt · 不传思考参数；与开关开/关 case 对比默认 thinking 证据",
  "category": "reasoning",
  "parameters": ["messages"],
  "requires_model_capability": "reasoning",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-5.1",
    "messages": [
      {
        "role": "user",
        "content": "Compute 23 + 19. Reply with one short sentence."
      }
    ],
    "max_completion_tokens": 512,
    "temperature": 0
  },
  "expect": {
    "http_status": 200,
    "thinking_location_probe": true,
    "assistant_content_non_empty": true,
    "notes": "与 enable_thinking open/close 三角对照共用 prompt；用于判断默认是否已暴露 thinking。"
  }
}
