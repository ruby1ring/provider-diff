{
  "case_id": "thinking_enable_thinking_with_budget",
  "title": "enable_thinking=true + thinking_budget=1000 · 应出现 thinking 内容；usage reasoning_tokens/thinking_tokens > 0",
  "category": "reasoning",
  "parameters": ["enable_thinking", "thinking_budget"],
  "requires_model_capability": "reasoning",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-5.1",
    "messages": [
      {
        "role": "user",
        "content": "Use concise reasoning to compute 34 + 58, then give the final answer."
      }
    ],
    "enable_thinking": true,
    "thinking_budget": 1000,
    "max_completion_tokens": 1200
  },
  "expect": {
    "dialect": "qwen_enable_thinking",
    "axis": "intensity",
    "enum_value": "1000",
    "http_status": 200,
    "thinking_location_probe": true,
    "thinking_evidence_required": true,
    "assistant_content_non_empty": true,
    "provider_extension": true,
    "notes": "Qwen-style budget 常见组合形态。"
  }
}
