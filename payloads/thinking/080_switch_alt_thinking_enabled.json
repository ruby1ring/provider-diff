{
  "case_id": "thinking_switch_alt_thinking_enabled",
  "title": "thinking.type=enabled 开启思考 · 应出现 reasoning/thinking 内容；usage 中 reasoning_tokens 或 thinking_tokens > 0",
  "category": "reasoning",
  "parameters": ["thinking"],
  "requires_model_capability": "reasoning",
  "method": "POST",
  "path": "/chat/completions",
  "payload": {
    "model": "gpt-5.1",
    "messages": [
      {
        "role": "user",
        "content": "Compute 23 + 19. Reply with one short sentence."
      }
    ],
    "thinking": {
      "type": "enabled"
    },
    "max_completion_tokens": 512,
    "temperature": 0
  },
  "expect": {
    "dialect": "thinking_object",
    "axis": "switch_equiv_on",
    "enum_value": "enabled",
    "equivalence_group": "reasoning_switch_open",
    "reference_case_id": "thinking_enable_thinking_true",
    "http_status": 200,
    "thinking_location_probe": true,
    "thinking_evidence_required": true,
    "assistant_content_non_empty": true,
    "provider_extension": true,
    "notes": "与 enable_thinking=true 共用 prompt；用于检测 thinking 对象形态是否真正开启思考（百炼部分区域仅接受不生效）。"
  }
}
