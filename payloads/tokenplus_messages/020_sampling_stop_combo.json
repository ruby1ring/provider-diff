{
  "case_id": "tp_messages_sampling_stop_combo",
  "title": "temperature, top_p, top_k, and stop_sequences",
  "category": "sampling",
  "test_nature": "deterministic",
  "parameters": [
    "temperature",
    "top_p",
    "top_k",
    "stop_sequences[]"
  ],
  "method": "POST",
  "path": "/messages",
  "payload": {
    "model": "deepseek-chat",
    "max_tokens": 512,
    "messages": [
      {
        "role": "user",
        "content": "Write a short response and end with END."
      }
    ],
    "temperature": 0.4,
    "top_p": 0.9,
    "top_k": 40,
    "stop_sequences": [
      "END",
      "<END>"
    ]
  },
  "expect": {
    "notes": "Checks the combined sampling request shape without making a probabilistic quality claim."
  }
}