{
  "provider": "tools_messages",
  "base_url": "https://api.anthropic.com",
  "endpoint": "/v1/messages",
  "method": "POST",
  "default_model": "claude-sonnet-4-6",
  "notes": [
    "Messages API tools 探针：运行时请把 Base URL、Model 和 API Key 改成待测渠道。",
    "P0 case 覆盖 tools 接受、强制调用、多轮 tool_result。"
  ],
  "common_expect": {
    "http_status": 200,
    "support_conclusion": "supported",
    "required_response_fields": ["id", "type", "role", "content", "model"],
    "content_required_fields": ["type"]
  },
  "cases": [
    "010_tools_auto.json",
    "011_tools_choice_required.json",
    "012_tools_multiturn_tool_result.json",
    "020_tools_choice_none.json",
    "021_tools_named_function.json"
  ]
}
